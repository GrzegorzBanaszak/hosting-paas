{
  "ConnectionStrings": {
    "HostingPaaSDatabase": "Host=localhost;Port=5432;Database=hosting_paas_dev;Username=hosting_paas;Password=hosting_paas"
  },
  "Auth": {
    "Jwt": {
      "SigningKey": "dev-only-signing-key-change-before-shared-usage",
      "Issuer": "hosting-paas-api-dev",
      "Audience": "hosting-paas-admin-dev",
      "AccessTokenLifetimeMinutes": 240
    },
    "BootstrapAdmin": {
      "Username": "admin",
      "Password": "Admin123!",
      "Email": "admin@localhost",
      "DisplayName": "Local Admin"
    }
  },
  "Platform": {
    "EnvironmentName": "Development"
  },
  "Observability": {
    "LogRequestBodies": false
  },
  "DeploymentPipeline": {
    "QueueCapacity": 100,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 2,
    "CommandTimeoutSeconds": 300,
    "ArtifactRootPath": "artifacts",
    "ExecuteStartCommandOnRestart": false
  },
  "Runtime": {
    "HealthCheckTimeoutSeconds": 5,
    "MonitorIntervalSeconds": 3,
    "RecentLogsLimit": 100,
    "LocalHealthCheckHost": "127.0.0.1"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:4173",
      "http://127.0.0.1:4173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
