{
  "ConnectionStrings": {
    "HostingPaaSDatabase": "Host=localhost;Port=5432;Database=hosting_paas;Username=hosting_paas;Password=hosting_paas"
  },
  "Auth": {
    "Jwt": {
      "SigningKey": "change-this-signing-key-before-production-use",
      "Issuer": "hosting-paas-api",
      "Audience": "hosting-paas-admin",
      "AccessTokenLifetimeMinutes": 60
    },
    "BootstrapAdmin": {
      "Username": "admin",
      "Password": "ChangeMe123!",
      "Email": "admin@hosting-paas.local",
      "DisplayName": "Platform Admin"
    }
  },
  "Platform": {
    "ServiceName": "hosting-paas-api",
    "EnvironmentName": "Production"
  },
  "Observability": {
    "LogRequestBodies": false
  },
  "DeploymentPipeline": {
    "QueueCapacity": 100,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 5,
    "CommandTimeoutSeconds": 900,
    "ArtifactRootPath": "artifacts",
    "ExecuteStartCommandOnRestart": false
  },
  "Runtime": {
    "HealthCheckTimeoutSeconds": 10,
    "MonitorIntervalSeconds": 5,
    "RecentLogsLimit": 100,
    "LocalHealthCheckHost": "127.0.0.1"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:4173",
      "http://127.0.0.1:4173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
