@api_HostAddress = http://localhost:5070
@adminUsername = admin
@adminPassword = Admin123!
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..svxwo0CuKBv-EsYCUhA5tGzcXWKHoRhaAG_YIwTGDEc
@appId = 11111111-1111-1111-1111-111111111111

###

GET {{api_HostAddress}}/api/system
Accept: application/json

###

GET {{api_HostAddress}}/api/system/ready
Accept: application/json

###

GET {{api_HostAddress}}/health
Accept: application/json

###

POST {{api_HostAddress}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "username": "{{adminUsername}}",
  "password": "{{adminPassword}}"
}

###

GET {{api_HostAddress}}/api/auth/me
Accept: application/json
Authorization: Bearer {{adminToken}}

###

GET {{api_HostAddress}}/api/admin/access
Accept: application/json
Authorization: Bearer {{adminToken}}

###

GET {{api_HostAddress}}/api/apps
Accept: application/json
Authorization: Bearer {{adminToken}}

###

GET {{api_HostAddress}}/api/apps/11111111-1111-1111-1111-111111111111
Accept: application/json
Authorization: Bearer {{adminToken}}

###

POST {{api_HostAddress}}/api/apps
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Docs Service",
  "slug": "docs-service",
  "description": "Internal documentation app",
  "status": "Draft",
  "port": 8081,
  "buildCommand": "docker build -t docs-service .",
  "startCommand": "docker run -p 8081:8081 docs-service",
  "projectRootPath": "/src",
  "healthCheckPath": "/health",
  "primaryHostname": "docs.hosting-paas.local"
}

###

PUT {{api_HostAddress}}/api/apps/11111111-1111-1111-1111-111111111111
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Hosting PaaS Demo",
  "slug": "hosting-paas-demo",
  "description": "Seed app updated from API",
  "status": "Running",
  "port": 8080,
  "buildCommand": "docker build -t hosting-paas-demo .",
  "startCommand": "docker run -p 8080:8080 hosting-paas-demo",
  "projectRootPath": "/src",
  "healthCheckPath": "/health",
  "primaryHostname": "demo.hosting-paas.local"
}

###

DELETE {{api_HostAddress}}/api/apps/11111111-1111-1111-1111-111111111111
Accept: application/json
Authorization: Bearer {{adminToken}}

###

GET {{api_HostAddress}}/api/apps/{{appId}}/repository
Accept: application/json
Authorization: Bearer {{adminToken}}

###

PUT {{api_HostAddress}}/api/apps/{{appId}}/repository
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{adminToken}}

{
  "provider": "GitHub",
  "owner": "example",
  "name": "hosting-paas-demo",
  "branch": "main",
  "cloneUrl": "https://github.com/example/hosting-paas-demo.git",
  "externalRepositoryId": "repo_seed_demo",
  "webhookSecret": "change-me"
}

###

POST {{api_HostAddress}}/api/apps/{{appId}}/deployments/redeploy
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{adminToken}}

{
  "commitSha": "abcdef1",
  "branch": "main"
}

###

DELETE {{api_HostAddress}}/api/apps/{{appId}}/repository
Accept: application/json
Authorization: Bearer {{adminToken}}

###

POST {{api_HostAddress}}/api/webhooks/github
Content-Type: application/json
X-GitHub-Event: push
X-Hub-Signature-256: sha256=replace-with-signature

{
  "ref": "refs/heads/main",
  "after": "abcdef1",
  "repository": {
    "name": "hosting-paas-demo",
    "default_branch": "main",
    "owner": {
      "name": "example"
    }
  }
}
